#!/bin/bash
# Stand-in for zstd that uses gzip as the container, so tests do not need the
# real binary. Supports: -t FILE | -d FILE -c | -dc [FILE] | compress stdin
# [-o FILE]. The level and -T value are logged as "zstd-level N" and
# "zstd-threads N".
#   MC_TEST_REAL_TOOLS=1        runs the real zstd when the host has one (the
#                               failure injections below still apply)
#   ZSTD_SHIM_FAIL_TEST=1       makes -t fail
#   ZSTD_SHIM_FAIL_DECOMPRESS=1 makes decompression fail after some output
#   ZSTD_SHIM_ENOSPC=1          compression writes a partial file and exits 1
#   ZSTD_SHIM_STALL=<marker>    compression writes <marker>.started, then waits
#                               for <marker>.release (signal tests)
echo "zstd $*" >> "$SHIM_LOG"
echo "zstd-umask $(umask)" >> "$SHIM_LOG"
test_mode=false; decompress=false; out=""; in=""; level=""; threads=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    -t) test_mode=true ;;
    -d) decompress=true ;;
    -dc|-cd) decompress=true ;;
    -o) i=$((i + 1)); out="${args[$i]}" ;;
    -T*) threads="${args[$i]#-T}" ;;
    -[0-9]|-[0-9][0-9]) level="${args[$i]#-}" ;;
    -c|-N|-q|-f|--check|--no-progress) ;;
    -*) ;;
    *) in="${args[$i]}" ;;
  esac
done
[[ -n "$level" ]] && echo "zstd-level $level" >> "$SHIM_LOG"
[[ -n "$threads" ]] && echo "zstd-threads $threads" >> "$SHIM_LOG"

real=false
[[ "${MC_TEST_REAL_TOOLS:-}" == 1 && -n "${REAL_ZSTD:-}" ]] && real=true
decompress_cmd() {
  if $real; then "$REAL_ZSTD" -dc "$@"; else gzip -dc "$@"; fi
}

if $test_mode; then
  [[ "${ZSTD_SHIM_FAIL_TEST:-}" == 1 ]] && exit 1
  if $real; then exec "$REAL_ZSTD" "$@"; fi
  gzip -t "$in"
elif $decompress; then
  if [[ "${ZSTD_SHIM_FAIL_DECOMPRESS:-}" == 1 ]]; then
    if [[ -n "$in" ]]; then decompress_cmd "$in" | head -c 512; else decompress_cmd | head -c 512; fi
    exit 1
  fi
  if [[ -n "$in" ]]; then decompress_cmd "$in"; else decompress_cmd; fi
else
  if [[ -n "${ZSTD_SHIM_STALL:-}" ]]; then
    echo "$$" > "$ZSTD_SHIM_STALL.started"
    for ((n = 0; n < 600; n++)); do [[ -e "$ZSTD_SHIM_STALL.release" ]] && break; /bin/sleep 0.1; done
  fi
  if [[ "${ZSTD_SHIM_ENOSPC:-}" == 1 ]]; then
    if [[ -n "$out" ]]; then head -c 100 > "$out"; else head -c 100; fi
    echo "zstd: No space left on device" >&2
    exit 1
  fi
  if $real; then exec "$REAL_ZSTD" "$@"; fi
  if [[ -n "$out" ]]; then gzip -c > "$out"; else gzip -c; fi
fi
