#!/bin/bash
# SS_SHIM_LISTEN="25565 [::]:25566" reports those listeners for `ss -ltnH` (a bare
# number means 0.0.0.0:<port>); without it, defers to the real ss.
[[ -n "${SHIM_LOG:-}" ]] && echo "ss $*" >> "$SHIM_LOG"
if [[ -n "${SS_SHIM_LISTEN+x}" ]]; then
  for entry in $SS_SHIM_LISTEN; do
    if [[ "$entry" == \[* ]]; then
      local_addr="$entry"; peer="[::]:*"
    elif [[ "$entry" == *:* ]]; then
      local_addr="$entry"; peer="0.0.0.0:*"
    else
      local_addr="0.0.0.0:$entry"; peer="0.0.0.0:*"
    fi
    printf 'LISTEN 0      4096   %s   %s\n' "$local_addr" "$peer"
  done
  exit 0
fi
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
clean_path=""
IFS=: read -ra parts <<< "$PATH"
for p in "${parts[@]}"; do
  [[ "$p" == "$self_dir" ]] || clean_path="${clean_path:+$clean_path:}$p"
done
real="$(PATH="$clean_path" command -v ss)" || { echo "ss: not found" >&2; exit 127; }
exec "$real" "$@"
