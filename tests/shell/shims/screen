#!/bin/bash
echo "screen $*" >> "$SHIM_LOG"
# SCREEN_SHIM_SAVE_LOG=<file>: a stuffed save-all is answered with a log line at
# once, the way a fast save does.
if [[ -n "${SCREEN_SHIM_SAVE_LOG:-}" && "$*" == *save-all* ]]; then
  echo "[00:00:00] [Server thread/INFO]: Saved the game" >> "$SCREEN_SHIM_SAVE_LOG"
fi
if [[ "$1" == "-list" ]]; then
  if [[ -e "$SHIM_STATE/screen_running" ]]; then
    printf 'There is a screen on:\n\t1234.%s\t(Detached)\n1 Socket in /run/screen.\n' "${SCREEN_SHIM_SESSION:-$INSTANCE_NAME}"
    exit 0
  fi
  echo "No Sockets found in /run/screen."
  exit 1
fi
exit 0
