#!/bin/bash
# Records calls and flips the fake screen session state.
#   SYSTEMCTL_SHIM_UNIT   text printed by `systemctl cat`
#   SYSTEMCTL_STOP_RC=N  exit status of `stop` (session stays up when non-zero)
echo "systemctl $*" >> "$SHIM_LOG"
case "$1" in
  stop)
    rc="${SYSTEMCTL_STOP_RC:-0}"
    [[ "$rc" == 0 ]] && rm -f "$SHIM_STATE/screen_running"
    exit "$rc"
    ;;
  list-unit-files)
    # Like systemd 257: exit 1 and no listing when the unit does not exist.
    for u in ${SYSTEMCTL_SHIM_UNITS:-}; do
      if [[ "${2:-}" == "$u" ]]; then echo "$u enabled"; exit 0; fi
    done
    exit 1
    ;;
  cat) printf '%s\n' "${SYSTEMCTL_SHIM_UNIT:-}" ;;
  is-enabled) echo enabled; exit 0 ;;
  start|restart) touch "$SHIM_STATE/screen_running" ;;
  is-active)
    if [[ -e "$SHIM_STATE/screen_running" ]]; then echo active; exit 0; fi
    echo inactive; exit 3
    ;;
esac
exit 0
